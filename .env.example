# ============================================================
# Boba Dash — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Supabase (Dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat (Dashboard → Project Settings)
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-api-key

# PayPal (Developer Dashboard → REST API apps)
EXPO_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# Game Config
EXPO_PUBLIC_GAME_VERSION=0.1.0
